datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  email           String           @unique
  name            String
  password        String
  role            String           @default("SALESMAN")
  contacts        Contact[]
  deals           Deal[]
  specimenRecords SpecimenRecord[]
  assignedTasks   Task[]           @relation("TaskAssignedTo")
  createdTasks    Task[]           @relation("TaskCreatedBy")
  taskComments    TaskComment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Contact {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String        @unique
  phone     String
  company   String?
  status    ContactStatus @default(LEAD)
  notes     String?
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals     Deal[]
  tasks     Task[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Deal {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  value     Float
  stage     DealStage @default(QUALIFICATION)
  contactId String    @db.ObjectId
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Menu {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  path        String
  iconName    String
  roles       String[]
  order       Int          @default(0)
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PermissionAction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  role      String
  menuId    String   @db.ObjectId
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  actions   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, menuId])
}

model Board {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  shortName String
  status    Boolean  @default(true)
  classes   Class[]
  schools   School[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  status    Boolean  @default(true)
  logo      String?
  boardId   String   @db.ObjectId
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  status    Boolean  @default(true)
  logo      String?
  classId   String   @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  categories Category[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  status    Boolean  @default(true)
  logo      String?
  subjectId String   @db.ObjectId
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum MovementType {
  INWARD
  OUTWARD
  SPECIMEN_ISSUE
  ADJUSTMENT
}

model Product {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  price           Float
  discount        Float            @default(0)
  discountedPrice Float            @default(0)
  status          Boolean          @default(true)
  offer           Boolean          @default(false)
  coupon          String?
  image           String?
  gallery         String[]
  sku             String?          @unique
  stockQuantity   Int              @default(100)
  minStockThreshold Int            @default(10)
  stockStatus     StockStatus      @default(IN_STOCK)
  categoryId      String           @db.ObjectId
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  specimenRecords SpecimenRecord[]
  stockMovements  StockMovement[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model StockMovement {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  productId     String       @db.ObjectId
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  referenceNo   String?
  createdBy     String?
  createdAt     DateTime     @default(now())
}

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?
  userEmail  String?
  userName   String?
  action     String   // VISIT, CREATE, UPDATE, DELETE
  resource   String   // CONTACT, DEAL, PRODUCT, MENU, ROLE, PERMISSION
  details    String?
  oldValues  Json?
  newValues  Json?
  timestamp  DateTime @default(now())
}

// ─── Master Data Management Hierarchy ───────────────────────────────────────
enum SchoolType {
  PUBLIC
  PRIVATE
}

model State {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String     @unique
  code      String?
  status    Boolean    @default(true)
  districts District[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  stateId   String   @db.ObjectId
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zones     Zone[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stateId, name])
}

model Zone {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  districtId String   @db.ObjectId
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  schools    School[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([districtId, name])
}

model School {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      SchoolType @default(PRIVATE) // PUBLIC or PRIVATE
  address   String?
  zoneId    String     @db.ObjectId
  zone      Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  boardId   String     @db.ObjectId
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  teachers  Teacher[]
  tasks     Task[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Teacher {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String
  email       String?
  subject     String?
  designation String?
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, phone])
}

// ─── Specimen Book Distribution Tracker ───────────────────────────────────────
model SpecimenRecord {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId

  // Book reference
  bookId             String    @db.ObjectId
  book               Product   @relation(fields: [bookId], references: [id], onDelete: Restrict)

  // Teacher & School details
  teacherName        String
  teacherPhone       String?
  teacherSchool      String
  teacherSubject     String?

  // Proof Image & Image Hash for Duplicate Image Detection
  proofImage         String?   // Uploaded image proof
  imageHash          String?   // MD5 hash of uploaded image file

  // Salesperson who distributed the book
  salesPersonId      String    @db.ObjectId
  salesPerson        User      @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)

  // Record state & Superadmin Verification
  handedAt           DateTime  @default(now())
  status             String    @default("GIVEN") // GIVEN | RETURNED | LOST
  verificationStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED
  flagReason         String?   // DUPLICATE_IMAGE | DUPLICATE_TEACHER | DUPLICATE_BOOK
  verifiedBy         String?   // Superadmin name/email
  verifiedAt         DateTime?
  notes              String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // DUPLICATE GUARD: same book cannot go to same teacher at same school twice
  @@unique([bookId, teacherName, teacherSchool])
}

// ─── Task Management System ──────────────────────────────────────────────────
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  SCHOOL_VISIT
  TEACHER_FOLLOWUP
  SPECIMEN_DISTRIBUTION
  DEAL_CLOSING
  MARKETING_CAMPAIGN
  GENERAL
}

model Task {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  priority     TaskPriority  @default(MEDIUM)
  status       TaskStatus    @default(TODO)
  category     TaskCategory  @default(GENERAL)
  dueDate          DateTime?
  completedAt      DateTime?
  isReadByAssignee Boolean       @default(false)

  // Assigned User & Creator
  assignedToId String?       @db.ObjectId
  assignedTo   User?         @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById  String        @db.ObjectId
  createdBy    User          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Optional relations to CRM entities
  schoolId     String?       @db.ObjectId
  school       School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  dealId       String?       @db.ObjectId
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)

  contactId    String?       @db.ObjectId
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  comments     TaskComment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model TaskComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}



