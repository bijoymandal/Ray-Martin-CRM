datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  email           String           @unique
  name            String
  password        String
  role            String           @default("SALESMAN")
  contacts        Contact[]
  deals           Deal[]
  specimenRecords SpecimenRecord[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Contact {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  status    ContactStatus @default(LEAD)
  notes     String?
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals     Deal[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Deal {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  value     Float
  stage     DealStage @default(QUALIFICATION)
  contactId String    @db.ObjectId
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Menu {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  path        String
  iconName    String
  roles       String[]
  order       Int          @default(0)
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PermissionAction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  role      String
  menuId    String   @db.ObjectId
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  actions   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, menuId])
}

model Board {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  shortName String
  status    Boolean  @default(true)
  classes   Class[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  status    Boolean  @default(true)
  logo      String?
  boardId   String   @db.ObjectId
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  status    Boolean  @default(true)
  logo      String?
  classId   String   @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  categories Category[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  status    Boolean  @default(true)
  logo      String?
  subjectId String   @db.ObjectId
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  price           Float
  discount        Float            @default(0)
  discountedPrice Float            @default(0)
  status          Boolean          @default(true)
  offer           Boolean          @default(false)
  coupon          String?
  image           String?
  gallery         String[]
  categoryId      String           @db.ObjectId
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  specimenRecords SpecimenRecord[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?
  userEmail  String?
  userName   String?
  action     String   // VISIT, CREATE, UPDATE, DELETE
  resource   String   // CONTACT, DEAL, PRODUCT, MENU, ROLE, PERMISSION
  details    String?
  oldValues  Json?
  newValues  Json?
  timestamp  DateTime @default(now())
}

// ─── Specimen Book Distribution Tracker ───────────────────────────────────────
model SpecimenRecord {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId

  // Book reference
  bookId             String    @db.ObjectId
  book               Product   @relation(fields: [bookId], references: [id], onDelete: Restrict)

  // Teacher & School details
  teacherName        String
  teacherPhone       String?
  teacherSchool      String
  teacherSubject     String?

  // Proof Image & Image Hash for Duplicate Image Detection
  proofImage         String?   // Uploaded image proof
  imageHash          String?   // MD5 hash of uploaded image file

  // Salesperson who distributed the book
  salesPersonId      String    @db.ObjectId
  salesPerson        User      @relation(fields: [salesPersonId], references: [id], onDelete: Restrict)

  // Record state & Superadmin Verification
  handedAt           DateTime  @default(now())
  status             String    @default("GIVEN") // GIVEN | RETURNED | LOST
  verificationStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED
  flagReason         String?   // DUPLICATE_IMAGE | DUPLICATE_TEACHER | DUPLICATE_BOOK
  verifiedBy         String?   // Superadmin name/email
  verifiedAt         DateTime?
  notes              String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // DUPLICATE GUARD: same book cannot go to same teacher at same school twice
  @@unique([bookId, teacherName, teacherSchool])
}


